# Resend (required for waitlist)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=thalesbrederodes@gmail.com

# Segment ID from Resend URL: resend.com/audience?segmentId=YOUR_ID
RESEND_AUDIENCE_ID=7e3a8719-fd0c-4428-bde1-956fcd09054f

# Optional: shown in footer mailto link
NEXT_PUBLIC_SUPPORT_EMAIL=thalesbrederodes@gmail.com

# Site URL for SEO (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://kalma.cc

# Search engine verification (optional — set after registering in GSC / Bing)
# Google Search Console: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Post-deploy SEO checklist:
# 1. Set NEXT_PUBLIC_SITE_URL=https://kalma.cc in production (Vercel)
# 2. Register https://kalma.cc in Google Search Console + Bing Webmaster Tools
# 3. Submit https://kalma.cc/sitemap.xml
# 4. Validate rich results: Organization, SoftwareApplication, FAQPage, BlogPosting
# 5. Test OG previews: Facebook Sharing Debugger, Twitter Card Validator
